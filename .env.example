# IsoForge local Compose defaults. Copy this file to .env if you want to
# override the documented defaults. The built-in LocalStack credentials are
# deliberately non-secret development values and are not suitable elsewhere.

CELLD_PUBLIC_PORT=8787
CELLD_BUCKET=isoforge-celld
AWS_REGION=us-east-1

# Optional local MCP protection. Keep real tokens out of this example file;
# export MCP_BEARER_TOKEN in the shell before starting Compose instead.
# MCP_BEARER_TOKEN=

# Optional host/origin overrides for a browser served from another origin.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# The SDK origin helper receives hostnames, not URL strings.
# ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
